---
permalink: index.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
{%- set pageTitle = site.name + ": " + site.tagline -%}
{%- set canonical = "/" -%}
{%- set schema = "website" -%}
{% include "head.njk" %}
<body class="splash-page">
  <header class="topbar">
    <nav aria-label="Site">
      <a href="index.html" aria-current="page">Home</a>
      <a href="notes.html">Notes</a>
      <a href="contact.html">Contact</a>
    </nav>
  </header>

  <main class="splash">
    <h1 class="sr-only">{{ site.name }}: {{ site.tagline }}</h1>
    <div class="sky" aria-hidden="true">
      <div class="cloud-layer">
        <div class="cloud-scaler">
          <div class="cloud-track">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
          </div>
        </div>
      </div>

      <div class="cloud-layer cloud-layer--offset">
        <div class="cloud-scaler">
          <div class="cloud-track">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
          </div>
        </div>
      </div>
    </div>

    <div class="splash-props" aria-hidden="true">
      <div class="splash-prop splash-prop--house">
        <img
          class="splash-house"
          src="assets/house-6.webp"
          alt=""
          width="96"
          height="128"
          draggable="false"
        >
      </div>
      <div class="splash-prop splash-prop--bed">
        <img
          class="splash-bed"
          src="assets/bed-6.webp"
          alt=""
          width="32"
          height="48"
          draggable="false"
        >
      </div>
    </div>

    <a class="title-link" href="notes.html" aria-label="{{ site.name }} — Notes">
      <span class="title-star-slot">
        <img
          class="title-star"
          src="assets/star.png"
          alt=""
          width="24"
          height="21"
          draggable="false"
        >
      </span>
      <img
        class="title"
        src="assets/title.png"
        alt=""
        width="149"
        height="21"
        draggable="false"
      >
      <img
        class="title-sub"
        src="assets/subtitle.png"
        alt=""
        width="99"
        height="4"
        draggable="false"
      >
    </a>
  </main>
  <script src="js/cloud-drag.js" defer></script>
</body>
</html>
