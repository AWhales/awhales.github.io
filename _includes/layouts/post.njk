<!DOCTYPE html>
<html lang="en">
{%- set pageTitle = title + " — " + site.name -%}
{%- set shareDescription = description or (content | firstParagraph) -%}
{%- set shareImage = preview or (content | firstImage) -%}
{%- set imageAlt = title -%}
{%- set noindex = wip -%}
{%- set ogType = "article" -%}
{%- set schema = "article" -%}
{%- set published = date -%}
{%- set assetPrefix = "../" -%}
{% include "head.njk" %}
<body class="page">
  <div class="page-sky">
    {% include "sky.njk" %}
  </div>

  <header class="topbar">
    <nav aria-label="Site">
      <a href="../index.html">Home</a>
      <a href="../notes.html" aria-current="page">Notes</a>
      <a href="../contact.html">Contact</a>
    </nav>
  </header>

  <article class="page-main post">
    <p class="post-meta"><a class="post-back" href="../notes.html">Notes</a> · {{ date | readableDate }}</p>
    <h1 class="post-title">
      {{ title }}
      {%- if wip %} <span class="post-badge">WIP</span>{%- endif %}
    </h1>
    <div class="post-body">{{ content | safe }}</div>

    <section
      class="comments"
      data-comments
      data-page="{{ page.fileSlug }}"
      data-api="https://moonlight-comments.alexjameswaite.workers.dev"
    >
      <h2 class="comments-title">Comments</h2>
      <p class="comments-empty" data-comments-empty hidden>No comments yet.</p>
      <ul class="comment-list" data-comments-list></ul>
      <form class="comment-form" data-comments-form>
        <div class="comment-honey" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </label>
        </div>
        <label>
          Name
          <input type="text" name="name" maxlength="32" required autocomplete="nickname" placeholder="Your name">
        </label>
        <label>
          Comment
          <textarea name="body" rows="3" maxlength="800" required placeholder="Say something…"></textarea>
        </label>
        <button type="submit">Post</button>
        <p class="comments-status" data-comments-status role="status"></p>
      </form>
    </section>

    {% set assetBase = "../" %}
    {% include "newsletter.njk" %}
  </article>
  <script src="../js/cloud-drag.js" defer></script>
  <script src="../js/media-toggle.js" defer></script>
  <script src="../js/comments.js" defer></script>
</body>
</html>
