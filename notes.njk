---
permalink: notes.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes — Day of the Planet of the Night</title>
  <link rel="stylesheet" href="css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Silkscreen:wght@400&display=swap" rel="stylesheet">
</head>
<body class="page">
  <div class="page-sky">
    {% include "sky.njk" %}
  </div>

  <header class="topbar">
    <nav aria-label="Site">
      <a href="index.html">Home</a>
      <a href="notes.html" aria-current="page">Notes</a>
      <a href="contact.html">Contact</a>
    </nav>
  </header>

  <main class="page-main page-main--notes">
    <h1>Notes</h1>
    <p class="page-intro">Occasional writing about the game — process, pictures, things that went wrong.</p>

    <ul class="post-list">
      {%- for post in collections.posts -%}
      {%- set preview = post.data.preview or (post.templateContent | firstImage) -%}
      <li class="post-card">
        <a href="{{ post.url }}">
          {%- if preview %}
          <img class="post-card-preview" src="{{ preview | stillSrc }}" alt="">
          {%- endif %}
          <time datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
          <span class="post-card-title">
            {{ post.data.title }}
            {%- if post.data.wip %} <span class="post-badge">WIP</span>{%- endif %}
          </span>
          <span class="post-card-tease">{{ post.templateContent | firstParagraph }}</span>
        </a>
      </li>
      {%- endfor -%}
    </ul>
  </main>
  <script src="js/cloud-drag.js" defer></script>
</body>
</html>
