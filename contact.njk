permalink: contact.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
{%- set pageTitle = "Contact — " + site.name -%}
{%- set description = "Send a message or subscribe to occasional updates about " + site.name + "." -%}
{%- set canonical = "/contact.html" -%}
{% include "head.njk" %}
<body class="page">
  <div class="page-sky">
    <div class="sky" aria-hidden="true">
      <div class="cloud-layer">
        <div class="cloud-scaler">
          <div class="cloud-track">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
          </div>
        </div>
      </div>

      <div class="cloud-layer cloud-layer--offset">
        <div class="cloud-scaler">
          <div class="cloud-track">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
            <img src="assets/parralax_clouds.png" alt="" width="386" height="127" draggable="false">
          </div>
        </div>
      </div>
    </div>
  </div>

  <header class="topbar">
    <nav aria-label="Site">
      <a href="index.html">Home</a>
      <a href="notes.html">Notes</a>
      <a href="contact.html" aria-current="page">Contact</a>
    </nav>
  </header>

  <main class="page-main page-main--contact">
    <h1>Contact</h1>

    <section
      class="contact"
      data-contact
      data-api="https://moonlight-comments.alexjameswaite.workers.dev"
    >
      <p class="page-intro">Send a message — it lands in my inbox.</p>

      <form class="comment-form" data-contact-form>
        <div class="comment-honey" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </label>
        </div>
        <label>
          Name
          <input type="text" name="name" maxlength="64" required autocomplete="name" placeholder="Your name">
        </label>
        <label>
          Email
          <input type="email" name="email" maxlength="120" required autocomplete="email" placeholder="you@example.com">
        </label>
        <label>
          Message
          <textarea name="body" rows="5" maxlength="2000" required placeholder="What's on your mind?"></textarea>
        </label>
        <button type="submit">Send</button>
        <p class="comments-status" data-contact-status role="status"></p>
      </form>
    </section>

    <section
      class="newsletter"
      data-newsletter
      data-api="https://moonlight-comments.alexjameswaite.workers.dev"
    >
      <h2 class="newsletter-title">Newsletter</h2>
      <p class="page-intro">Occasional updates about the game — new notes, releases, that sort of thing.</p>

      <form class="newsletter-form" data-newsletter-form>
        <div class="comment-honey" aria-hidden="true">
          <label>
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
          </label>
        </div>
        <label class="newsletter-email">
          Email
          <input type="email" name="email" maxlength="120" required autocomplete="email" placeholder="you@example.com">
        </label>
        <button type="submit">Subscribe</button>
        <p class="comments-status" data-newsletter-status role="status"></p>
      </form>
    </section>
  </main>
  <script src="js/cloud-drag.js" defer></script>
  <script src="js/contact.js" defer></script>
  <script src="js/newsletter.js" defer></script>
</body>
</html>
